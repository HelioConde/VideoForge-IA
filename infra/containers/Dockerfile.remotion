# Dependencias oficiais do Remotion pre-instaladas apenas no build da imagem.
# Codigo e PNGs de video nao sao incorporados ao container.
FROM node:22-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive \
    CI=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 ffmpeg ca-certificates fonts-dejavu-core \
    libnss3 libdbus-1-3 libatk1.0-0 libgbm1 libasound2 \
    libxrandr2 libxkbcommon0 libxfixes3 libxcomposite1 \
    libxdamage1 libatk-bridge2.0-0 libpango-1.0-0 libcairo2 libcups2 \
    && ln -s /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/videoforge-remotion
COPY motion-remotion/package.json motion-remotion/package-lock.json ./
RUN npm ci --no-audit --no-fund
RUN ./node_modules/.bin/remotion browser ensure
WORKDIR /workspace
