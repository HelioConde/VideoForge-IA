# Media tools preinstalled: no apt-get during every VideoForge job.
FROM python:3.12-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ffmpeg fonts-dejavu-core fontconfig ca-certificates git tar gzip unzip && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
